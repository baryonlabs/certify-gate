 "knowledge": [
  {
   "id": "K1",
   "title": "가스 배관 기밀시험 절차",
   "text": "배관 설치 후 도시가스 공급 전에 공기 또는 질소로 규정 시험압력까지 가압하고 규정 시간 동안 압력 강하 여부를 확인한다. 이는 접합부의 미세 누출을 사용 전에 발견하기 위함이다."
  },
  {
   "id": "K2",
   "title": "비눗물 누출 검사",
   "text": "연결부 점검 시 발포성 누출 검사액을 이음부 전체에 도포하고 기포 발생 여부를 확인한다. 기포가 생기면 즉시 가스를 차단하고 해당 부위를 재시공한다."
  },
  {
   "id": "K3",
   "title": "작업 전 가스 차단 확인",
   "text": "기존 배관을 절단하거나 분해하기 전에 중간밸브를 잠그고 잔류 가스를 배출한 뒤 차단 상태를 확인한다. 잔류 가스에 의한 폭발 및 중독 사고를 예방하기 위함이다."
  },
  {
   "id": "K4",
   "title": "휴대용 가스검지기 사용",
   "text": "밀폐된 천장 내부나 좁은 공간에 진입하기 전 검지기를 영점 보정하고 가스 농도를 측정한다. 농도가 기준치 이상이면 환기 후 재측정하며 기준치 미만일 때만 작업한다."
  },
  {
   "id": "K5",
   "title": "나사 접합부 시공 기준",
   "text": "나사 이음 시 규격에 맞는 실링 테이프나 실링제를 나사산에 감고 체결한 뒤 나사산이 과다 노출되지 않도록 한다. 과도한 조임은 나사산 손상과 누출 원인이 되므로 금지한다."
  },
  {
   "id": "K6",
   "title": "배관 고정 및 이격 기준",
   "text": "배관은 규정 간격마다 고정 브래킷으로 고정하고 전기 배선 및 굴뚝과 규정 거리 이상 이격한다. 진동에 의한 이음부 이완과 열·전기적 영향을 막기 위함이다."
  },
  {
   "id": "K7",
   "title": "시공 일지 및 완성 검사 기록",
   "text": "시공 완료 후 시공 위치, 사용 자재, 시험 압력 및 결과를 시공 일지에 기록하고 서명한다. 이는 사후 추적 및 정기 검사의 근거 자료로 사용하기 위함이다."
  }
 ],
