 "knowledge": [
  {
   "id": "K1",
   "title": "시멘트 모르타르 압축강도 시험",
   "text": "KS L ISO 679에 따라 40×40×160mm 모르타르 공시체를 제작하여 재령 1, 3, 7, 28일에 압축강도를 측정한다. 재령별 강도 발현을 비교하여 결합재의 반응 경향을 평가하기 위함이다."
  },
  {
   "id": "K2",
   "title": "시험 재료 보관 및 시료 관리",
   "text": "시멘트 및 혼화재 시료는 밀봉 용기에 담아 습도 50% 이하의 시료실에 보관하고, 개봉 후 2주 이내에 사용한다. 공기 중 수분과 이산화탄소에 의한 풍화로 시료 특성이 변하는 것을 막기 위함이다."
  },
  {
   "id": "K3",
   "title": "양생 수조 온도 관리",
   "text": "공시체 양생 수조는 20±1°C로 유지하고 매일 오전 온도를 기록한다. 양생 온도 편차가 수화 반응 속도와 강도 결과에 영향을 주기 때문이다."
  },
  {
   "id": "K4",
   "title": "저탄소 결합재 배합 설계 절차",
   "text": "고로슬래그 미분말, 플라이애시 등 혼화재 치환율을 5% 단위로 달리하여 시험 배합을 작성하고, 물-결합재비는 0.485로 고정하여 비교한다. 치환율 외의 변수를 통제하여 영향을 분리하기 위함이다."
  },
  {
   "id": "K5",
   "title": "유동성 시험(플로) 측정",
   "text": "모르타르 혼련 직후 플로 테이블에서 15회 낙하 후 퍼짐 값을 측정하여 기록한다. 배합 간 시공성 차이를 정량적으로 비교하기 위함이다."
  },
  {
   "id": "K6",
   "title": "시험실 보호구 착용 규정",
   "text": "시멘트 분말 취급과 혼련 작업 시 방진마스크, 보안경, 내알칼리 장갑을 착용한다. 시멘트 분진과 알칼리성 슬러리가 호흡기와 피부에 손상을 주기 때문이다."
  },
  {
   "id": "K7",
   "title": "현장 의뢰 기술 문서 작성",
   "text": "현장 의뢰 건의 시험 결과 보고서에는 시험 조건, 측정값, 결론을 표준 양식에 따라 기재하고 책임자의 검토 서명을 받아 발송한다. 결과의 추적성과 책임 소재를 확보하기 위함이다."
  }
 ],
 "items": [
  {
   "id": "J01",
   "behavior": "혼련 직후 믹서 날개에 붙은 모르타르 덩어리를 손으로 긁어 점도를 확인한다."
  },
  {
   "id": "J02",
   "behavior": "플로 측정값이 평소 범위 밖이면 같은 배합으로 한 번 더 혼련해 다시 잰다."
  },
  {
   "id": "J03",
   "behavior": "분말 시료를 덜어낼 때 방진마스크와 보안경을 쓰고 내알칼리 장갑을 낀다."
  },
  {
   "id": "J04",
   "behavior": "치환율 비교 실험에서는 물량을 바꾸지 않고 같은 물-결합재비로 모든 배합을 혼련한다."
  },
  {
   "id": "J05",
   "behavior": "고로슬래그 치환율 50% 이상 배합은 1일 강도 값만 보고 합격 여부를 판단하지 않고 7일까지 기다린다."
  },
  {
   "id": "J06",
   "behavior": "현장에서 의뢰받은 시험 결과는 책임자 서명을 받은 뒤에야 메일로 보낸다."
  },
  {
   "id": "J07",
   "behavior": "3일 강도 측정 후 파단면에 남은 슬래그 입자 색을 확대경으로 들여다본다."
  },
  {
   "id": "J08",
   "behavior": "압축강도 시험 중 이상하게 낮은 공시체가 나오면 폐기 전에 몰드 번호와 성형 순서를 대조한다."
  },
  {
   "id": "J09",
   "behavior": "현장 반장님과 통화할 때 시험값 대신 레미콘 타설 후 거푸집 해체 시점 얘기를 먼저 꺼낸다."
  },
  {
   "id": "J10",
   "behavior": "양생 수조 온도계가 20도를 벗어나면 그날 투입한 공시체에 별도 표시를 붙인다."
  },
  {
   "id": "J11",
   "behavior": "개봉한 지 열흘 된 플라이애시 통은 실험 배합에 쓰지 않고 다른 통을 연다."
  },
  {
   "id": "J12",
   "behavior": "비 온 다음 날 아침에는 시료실 제습기 배수통부터 비우고 시멘트 포대 바닥면을 만져본다."
  }
 ],
