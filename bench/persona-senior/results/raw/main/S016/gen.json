 "knowledge": [
  {
   "id": "K1",
   "title": "동백나무 전정 시기",
   "text": "동백나무 전정은 꽃이 진 직후부터 6월 말 사이에 완료한다. 7월 이후에는 다음 해 꽃눈이 형성되므로 가지를 자르면 개화량이 줄어든다."
  },
  {
   "id": "K2",
   "title": "종려나무 하엽 정리",
   "text": "종려나무의 늘어지거나 갈변한 하엽은 줄기에 가까운 잎자루 기부 부근에서 절단하고 수관 상부의 푸른 잎은 남긴다. 푸른 잎을 과도하게 제거하면 생육이 약해지기 때문이다."
  },
  {
   "id": "K3",
   "title": "전정 가위 소독 기준",
   "text": "전정 가위와 톱날은 작업 전후 및 병든 가지를 자른 직후 알코올로 소독한다. 도구를 통한 병원균 전염을 막기 위함이다."
  },
  {
   "id": "K4",
   "title": "고소작업 안전 규정",
   "text": "고소작업대와 사다리 작업 시 안전모와 안전대를 착용하고, 강풍 예보나 순간풍속이 높은 날에는 작업을 중지한다. 추락과 기구 전도 사고를 예방하기 위함이다."
  },
  {
   "id": "K5",
   "title": "수종별 식재 적기",
   "text": "동백나무는 늦가을부터 이른 봄, 종려나무는 지온이 오르는 늦봄부터 초여름에 식재한다. 수종별 뿌리 활동 시기에 맞추어 활착률을 높이기 위함이다."
  },
  {
   "id": "K6",
   "title": "작업구역 및 부산물 관리",
   "text": "전정 작업 구역에는 안내 콘을 설치하고 발생한 가지와 잎은 당일 수거하여 반출한다. 투숙객과 이용객의 동선 안전 및 시설 미관을 유지하기 위함이다."
  },
  {
   "id": "K7",
   "title": "신규 식재목 관수 점검",
   "text": "신규 식재목은 식재 첫해 점검표에 따라 정해진 주기로 관수 상태와 점적관수 장치 작동 여부를 확인한다. 초기 활착 기간의 수분 부족을 막기 위함이다."
  }
 ],
 "items": [
  {
   "id": "J01",
   "behavior": "강풍 예보가 뜬 날 고소작업대를 펼치지 않고 지상에서 할 수 있는 작업으로 바꾼다."
  },
  {
   "id": "J02",
   "behavior": "동백 꽃이 지는 주에 호텔 진입로 동백 울타리 전정을 시작해 6월 안에 끝낸다."
  },
  {
   "id": "J03",
   "behavior": "동백 가지를 자르기 전 수관에서 열 걸음쯤 물러나 로비 정면 쪽에서 윤곽을 본다."
  },
  {
   "id": "J04",
   "behavior": "전정 구역 둘레에 안내 콘을 세우고 해 지기 전에 가지를 수거 차량에 싣는다."
  },
  {
   "id": "J05",
   "behavior": "종려나무 잎자루를 잡을 때 가죽장갑 위에 코팅장갑을 한 겹 더 낀다."
  },
  {
   "id": "J06",
   "behavior": "새로 심은 동백 뿌리 쪽 흙을 손가락으로 5cm쯤 파서 마르면 물을 더 준다."
  },
  {
   "id": "J07",
   "behavior": "병든 동백 가지를 자른 뒤 가위 날을 알코올 솜으로 닦고 다음 나무로 간다."
  },
  {
   "id": "J08",
   "behavior": "비 온 다음 날 오전에는 동백 굵은 가지 전정을 미루고 오후에 시작한다."
  },
  {
   "id": "J09",
   "behavior": "7월 중순 전에 종려나무 열매대를 먼저 따내고 나서 잎을 정리한다."
  },
  {
   "id": "J10",
   "behavior": "종려 하엽을 자를 때 줄기에서 손가락 세 마디 정도 잎자루를 남겨 자른다."
  },
  {
   "id": "J11",
   "behavior": "호텔 동백 울타리를 다듬을 때 겉면만 치지 않고 안쪽 가지를 한 뼘씩 솎아낸다."
  },
  {
   "id": "J12",
   "behavior": "전정 가위가 굵은 가지에서 두 번 씹히면 바로 작업을 멈추고 점심시간에 날을 간다."
  }
 ],
