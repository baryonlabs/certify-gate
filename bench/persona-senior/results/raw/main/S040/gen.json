 "knowledge": [
  {
   "id": "K1",
   "title": "현장조사 보행동선 기록",
   "text": "보행환경 현장조사는 평일 출근·퇴근 시간대와 주말 낮에 각각 1회 이상 실시하고, 보행량과 동선을 조사야장에 기록한다. 시간대별 이용 패턴이 달라 단일 시점 조사로는 계획 근거가 부족하기 때문이다."
  },
  {
   "id": "K2",
   "title": "골목길 최소 유효폭 확보",
   "text": "보행자 우선도로 설계 시 보행 유효폭은 최소 1.5m 이상 확보하고, 불가능할 경우 일방통행 또는 보차 혼용 방식으로 전환한다. 휠체어와 유모차의 교행을 보장하기 위한 기준이다."
  },
  {
   "id": "K3",
   "title": "도시재생 주민의견 수렴",
   "text": "도시재생 활성화계획 수립 시 주민설명회를 최소 2회 개최하고 의견 접수 결과를 회의록에 첨부한다. 법정 절차 누락 시 승인 단계에서 반려될 수 있기 때문이다."
  },
  {
   "id": "K4",
   "title": "토지이용계획 지적도 대조",
   "text": "토지이용계획 도면 작성 전에 최신 지적도와 토지대장을 대조하여 필지 경계와 지목을 확인한다. 도면과 현황의 불일치로 인한 보상 및 인허가 분쟁을 예방하기 위함이다."
  },
  {
   "id": "K5",
   "title": "공공공간 야간 조명 점검",
   "text": "신규 조성 공공공간은 준공 전 야간에 조도를 측정하여 보행 구간 평균 조도 기준 이상인지 확인한다. 범죄 예방환경설계(CPTED) 기준 충족 여부를 입증하기 위함이다."
  },
  {
   "id": "K6",
   "title": "설계안 변경 이력 관리",
   "text": "설계안을 수정할 때는 변경 사유, 일자, 담당자를 변경대장에 기록하고 도면 버전을 갱신한다. 이후 협의 과정에서 최종안의 근거를 추적하기 위함이다."
  },
  {
   "id": "K7",
   "title": "관계부서 사전 협의",
   "text": "도로·상하수도·소방 관련 시설이 포함된 설계안은 도면 확정 전에 관계부서 협의를 거친다. 소방차 진입로와 지하매설물 간섭을 사전에 걸러내기 위함이다."
  }
 ],
