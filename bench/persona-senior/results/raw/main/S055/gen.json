 "knowledge": [
  {
   "id": "K1",
   "title": "작업 전 도구 소독 기준",
   "text": "작업 시작 전 칼, 도마, 갈고리는 82℃ 이상 온수 또는 소독액으로 소독하고, 교대 및 육종 전환 시마다 재소독한다. 이는 교차오염과 식중독균 증식을 방지하기 위함이다."
  },
  {
   "id": "K2",
   "title": "방한 장갑·안전장갑 착용",
   "text": "냉동·냉장 작업장에서는 방한 장갑 안쪽에 절단방지 안전장갑(메쉬 장갑)을 착용하고 작업한다. 칼 미끄러짐으로 인한 열상과 동상을 예방하기 위함이다."
  },
  {
   "id": "K3",
   "title": "칼 연마 및 교체 주기",
   "text": "분할용 칼은 작업 중 2시간마다 샤프닝 스틸로 날을 세우고, 일 1회 연마석으로 정식 연마한다. 날이 무디면 절단면이 거칠어지고 손에 힘이 과하게 들어가 사고 위험이 커지기 때문이다."
  },
  {
   "id": "K4",
   "title": "냉장육 보관 온도 관리",
   "text": "분할 대기 중인 원육은 0~4℃ 작업장에서 처리하고, 실온 노출 시간은 30분을 넘기지 않는다. 온도 상승 시 미생물 증식과 육색 변화가 빨라지기 때문이다."
  },
  {
   "id": "K5",
   "title": "등급 판정 기록 의무",
   "text": "입고된 원육은 도체 등급 표시와 실물을 대조하고, 불일치 시 즉시 품질 담당자에게 보고하며 입고 대장에 기록한다. 원산지·등급 표시 위반을 막고 이력 추적을 가능하게 하기 위함이다."
  },
  {
   "id": "K6",
   "title": "포장 전 이물 검사",
   "text": "분할·포장 공정 끝단에서 금속탐지기를 통과시키고, 매 2시간마다 테스트 피스로 감도를 점검한다. 칼 파편 등 이물이 소비자에게 유통되는 것을 막기 위함이다."
  },
  {
   "id": "K7",
   "title": "작업장 바닥 미끄럼 관리",
   "text": "작업 중 바닥에 고인 물과 지방 찌꺼기는 수시로 제거하고, 교대 시 미끄럼 방지 매트 상태를 확인한다. 낙상 사고를 예방하기 위함이다."
  }
 ],
