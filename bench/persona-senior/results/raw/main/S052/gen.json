 "knowledge": [
  {
   "id": "K1",
   "title": "배관 수압시험 절차",
   "text": "배관 설치 완료 후 설계압력의 1.5배로 수압시험을 실시하고 최소 30분간 압력 강하 여부를 확인한다. 이는 접합부 누설과 시공 결함을 운전 전에 발견하기 위함이다."
  },
  {
   "id": "K2",
   "title": "플랜지 볼트 체결 순서",
   "text": "플랜지 볼트는 대각선 방향 교차 순서로 단계적으로 토크를 올려 체결한다. 이는 가스켓에 하중이 균일하게 걸리도록 하여 편하중에 의한 누설을 방지하기 위함이다."
  },
  {
   "id": "K3",
   "title": "용접부 개선면 청소",
   "text": "용접 전 개선면과 양쪽 25mm 범위의 유분, 녹, 수분을 제거한다. 이는 기공과 용입 불량 등 용접 결함을 예방하기 위함이다."
  },
  {
   "id": "K4",
   "title": "스테인리스 배관 취급",
   "text": "스테인리스 배관은 탄소강 공구와 분리하여 사용하고 전용 연마재만 적용한다. 이는 철분 오염에 의한 부식 발생을 막기 위함이다."
  },
  {
   "id": "K5",
   "title": "배관 지지대 간격 기준",
   "text": "배관 지지대는 관경과 유체 종류에 따라 설계 도면에 명시된 간격으로 설치한다. 처짐과 진동으로 인한 응력 집중을 방지하기 위함이다."
  },
  {
   "id": "K6",
   "title": "밀폐공간 작업 허가",
   "text": "탱크, 맨홀 등 밀폐공간 진입 전 산소 및 유해가스 농도를 측정하고 작업허가서를 발급받는다. 질식 및 중독 사고를 예방하기 위함이다."
  },
  {
   "id": "K7",
   "title": "가스켓 선정 및 교체",
   "text": "플랜지 해체 시 사용한 가스켓은 재사용하지 않고 설계 사양에 맞는 신품으로 교체한다. 이는 압축 영구변형으로 인한 밀봉 성능 저하를 막기 위함이다."
  }
 ],
 "items": [
  {
   "id": "J01",
   "behavior": "해체한 플랜지를 다시 닫을 때 쓰던 가스켓을 버리고 새 가스켓 봉투를 뜯는다."
  },
  {
   "id": "J02",
   "behavior": "누설이 의심되는 플랜지에서 비눗물을 바르고 가스켓 테두리를 시계 방향으로 한 바퀴 훑는다."
  },
  {
   "id": "J03",
   "behavior": "스테인리스 라인 옆에서 작업할 때 철 연마석을 공구함에서 빼고 색깔 띠를 두른 연마기만 꺼낸다."
  },
  {
   "id": "J04",
   "behavior": "플랜지 볼트 너트를 조이기 전에 나사산에 손가락을 대고 한 바퀴씩 돌려 걸림을 확인한다."
  },
  {
   "id": "J05",
   "behavior": "배관 수압시험 물을 뺀 뒤 저점 드레인 밸브를 열어 두고 퇴근한다."
  },
  {
   "id": "J06",
   "behavior": "볼트 16개짜리 24인치 플랜지를 조일 때 토크렌치를 쥐고 별 모양으로 건너뛰며 세 바퀴 돈다."
  },
  {
   "id": "J07",
   "behavior": "수압시험 중 압력계 바늘이 멈춘 뒤에도 이음부 아래 바닥에 흰 종이를 깔아 두고 십 분 더 지켜본다."
  },
  {
   "id": "J08",
   "behavior": "용접 전 개선면을 와이어브러시로 닦은 뒤 장갑 낀 손가락으로 쓸어보고 다시 닦는다."
  },
  {
   "id": "J09",
   "behavior": "후배가 맞춘 엘보 연결부 앞에 서서 눈을 가늘게 뜨고 관 중심선을 따라 한쪽 눈으로 겨눈다."
  },
  {
   "id": "J10",
   "behavior": "지지대 사이 스팬 중간 구간에서 배관을 손바닥으로 눌러 처짐 정도를 가늠한 뒤 지지대를 한 개 더 넣는다."
  },
  {
   "id": "J11",
   "behavior": "겨울 새벽 현장에서 용접봉 건조 오븐을 켜고 한 시간 지난 뒤에야 첫 용접을 시작한다."
  },
  {
   "id": "J12",
   "behavior": "맨홀 진입 전 가스측정기를 맨홀 입구 안쪽으로 내려 수치를 읽은 뒤에야 작업허가서에 서명한다."
  }
 ],
