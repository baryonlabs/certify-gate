 "knowledge": [
  {
   "id": "K1",
   "title": "가죽 종류별 사전 식별",
   "text": "수선 접수 시 가죽의 종류(천연·인조, 염색 방식)를 먼저 확인하고 작업 카드에 기록한다. 종류에 따라 사용할 약품과 접착제가 다르므로 오인 시 변색·경화가 발생할 수 있기 때문이다."
  },
  {
   "id": "K2",
   "title": "약품 적용 전 패치 테스트",
   "text": "염료·보습제·복원제는 제품의 눈에 띄지 않는 안쪽 부위에 먼저 소량 도포하여 24시간 경과 후 변색 여부를 확인한 뒤 전체에 사용한다. 가죽마다 흡수율이 달라 반응이 예측되지 않기 때문이다."
  },
  {
   "id": "K3",
   "title": "소파 균열 충진 절차",
   "text": "소파 표면 균열은 먼지와 유분을 제거한 뒤 충진제를 얇게 2~3회 나누어 바르고, 각 회차마다 완전히 건조시킨다. 한 번에 두껍게 바르면 굳은 뒤 갈라지기 때문이다."
  },
  {
   "id": "K4",
   "title": "지갑 모서리 복원 작업",
   "text": "명품 지갑 모서리 복원 시 원래 스티치 구멍을 그대로 활용하고, 원단과 동일한 굵기의 실을 사용한다. 새 구멍을 내면 원형이 훼손되어 제품 가치가 하락하기 때문이다."
  },
  {
   "id": "K5",
   "title": "접착제 사용 환기 규정",
   "text": "용제형 접착제와 염료 희석제를 사용할 때는 작업장 창문을 열고 환기 장치를 가동하며, 작업 중 보호 마스크와 장갑을 착용한다. 유기용제 증기 흡입과 피부 접촉으로 인한 건강 피해를 막기 위함이다."
  },
  {
   "id": "K6",
   "title": "재단 칼날 점검 및 교체",
   "text": "가죽 재단용 칼과 스키빙 칼은 작업 시작 전 날 상태를 점검하고 무뎌진 날은 연마하거나 교체한다. 날이 무디면 절단면이 거칠어지고 손을 다칠 위험이 커지기 때문이다."
  },
  {
   "id": "K7",
   "title": "수선 완료품 보관·인도",
   "text": "수선이 끝난 제품은 완전 건조 후 통풍이 되는 선반에 보관하고 인도 전 최종 상태를 고객과 함께 확인한다. 건조가 덜 된 상태로 포장하면 곰팡이와 표면 끈적임이 생기기 때문이다."
  }
 ],
