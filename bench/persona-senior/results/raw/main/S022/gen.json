 "knowledge": [
  {
   "id": "K1",
   "title": "운영 DB 변경 전 백업",
   "text": "운영 데이터베이스의 스키마나 데이터를 변경하기 전에는 반드시 전체 백업을 수행하고 복구 가능 여부를 확인한다. 변경 실패 시 학적·성적 데이터가 유실되면 복구할 수 없기 때문이다."
  },
  {
   "id": "K2",
   "title": "학기 중 배포 제한",
   "text": "성적 입력 기간과 학기 초 수강 신청 기간에는 정기 배포를 금지하고 긴급 수정만 승인 후 반영한다. 사용 집중 시기의 장애가 교사의 행정 업무 전체에 영향을 주기 때문이다."
  },
  {
   "id": "K3",
   "title": "개인정보 마스킹 기준",
   "text": "학생 이름·연락처·주민 관련 정보는 로그와 테스트 데이터에서 마스킹 처리한다. 개인정보 유출 위험을 줄이고 관련 법령을 준수하기 위함이다."
  },
  {
   "id": "K4",
   "title": "성적 산출 로직 이중 검증",
   "text": "성적 계산 로직을 수정할 때는 기존 학기 데이터로 회귀 테스트를 수행하고 담당 교사의 검산 결과와 대조한다. 계산 오류는 학생 생활기록부에 직접 영향을 주기 때문이다."
  },
  {
   "id": "K5",
   "title": "요청 변경 관리 기록",
   "text": "교사의 기능 수정 요청은 요청자·일시·변경 내용을 이슈 티켓에 기록한 뒤 작업한다. 이후 변경 이력을 추적하고 요구 사항 충돌을 방지하기 위함이다."
  },
  {
   "id": "K6",
   "title": "API 변경 시 하위 호환",
   "text": "기존 API의 응답 필드를 삭제하거나 이름을 바꾸지 않고 신규 필드를 추가하는 방식으로 변경한다. 이미 연동된 학교별 시스템이 오작동하지 않도록 하기 위함이다."
  },
  {
   "id": "K7",
   "title": "AI 생성 코드 검토",
   "text": "AI 도구가 생성한 코드는 반드시 개발자가 직접 읽고 테스트를 통과한 후에만 병합한다. 검증되지 않은 코드가 핵심 로직에 유입되는 것을 막기 위함이다."
  }
 ],
