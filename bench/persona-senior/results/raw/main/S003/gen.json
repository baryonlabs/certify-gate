 "knowledge": [
  {
   "id": "K1",
   "title": "수배전반 절연저항 측정",
   "text": "수배전반 설치 후 통전 전에 500V 또는 1000V 메거로 각 상간 및 대지 간 절연저항을 측정하여 기록한다. 절연 불량 상태에서 통전하면 단락 및 화재 위험이 있기 때문이다."
  },
  {
   "id": "K2",
   "title": "접지저항 측정 및 기준",
   "text": "접지극 시공 후 접지저항계로 접지저항을 측정하고, 설계 기준값(예: 제3종 100Ω 이하 등 적용 기준) 이내임을 확인하여 성적서에 첨부한다. 이는 누전 시 전위 상승과 감전을 방지하기 위함이다."
  },
  {
   "id": "K3",
   "title": "전선관 배관 매립 전 검측",
   "text": "콘크리트 타설 전에 배관 경로, 지지 간격, 박스 위치를 도면과 대조하여 검측하고 검측 요청서에 서명한다. 타설 후에는 수정이 불가능하므로 사전 확인이 필수이다."
  },
  {
   "id": "K4",
   "title": "케이블 트레이 포설 점검",
   "text": "케이블 트레이 포설 시 전력·통신 케이블을 분리 배치하고 이격 거리를 확보하며 지지 간격을 점검표로 확인한다. 이는 유도 노이즈와 과열을 방지하기 위함이다."
  },
  {
   "id": "K5",
   "title": "차단기 정정값 확인",
   "text": "분전반 차단기는 보호협조 검토서의 정정값과 설치 값을 대조하고 설정 상태를 사진으로 기록한다. 정정값이 다르면 사고 시 상위 차단기가 먼저 동작하여 정전 범위가 확대되기 때문이다."
  },
  {
   "id": "K6",
   "title": "활선 근접 작업 안전 절차",
   "text": "활선 근접 작업 전에는 작업 허가서를 발급하고 잠금·표지(LOTO)를 실시한 뒤 검전기로 무전압을 확인한다. 오통전과 감전 사고를 방지하기 위한 필수 절차이다."
  },
  {
   "id": "K7",
   "title": "감리 일지 및 지적사항 관리",
   "text": "감리 일지에 일일 점검 내용과 지적사항을 기록하고, 시정 조치 결과를 확인한 후 종결 처리한다. 이는 책임 소재를 명확히 하고 이력을 추적하기 위함이다."
  }
 ],
 "items": [
  {
   "id": "J01",
   "behavior": "케이블 트레이 위 전력선과 통신선 사이를 자로 재어 점검표에 칸마다 표시한다."
  },
  {
   "id": "J02",
   "behavior": "수배전반 인입 전날 메거로 R·S·T상 각각 대지 간 값을 직접 읽어 일지에 적는다."
  },
  {
   "id": "J03",
   "behavior": "시공사가 가져온 메거 측정값이 전 상에서 똑같이 나오면 그 자리에서 다시 재 보게 한다."
  },
  {
   "id": "J04",
   "behavior": "슬래브 타설 전날 배관 박스 위치를 줄자로 재고 도면과 맞춰 검측서에 서명한다."
  },
  {
   "id": "J05",
   "behavior": "차단기 정정 사진에서 다이얼 옆 라벨이 가려져 있으면 다시 찍어 오라고 돌려보낸다."
  },
  {
   "id": "J06",
   "behavior": "타설 직전 슬래브 배근 위 전선관 곡부를 발로 눌러 보고 들뜬 구간을 짚어 결속을 지시한다."
  },
  {
   "id": "J07",
   "behavior": "트레이 곡부에서 케이블이 한쪽으로 쏠려 있으면 그 구간 전체의 결속 밴드를 풀게 한다."
  },
  {
   "id": "J08",
   "behavior": "분전반 차단기 설정 다이얼이 정정값과 같아도 상하위 차단기 조합이 도면과 다르면 협조 검토서를 다시 요청한다."
  },
  {
   "id": "J09",
   "behavior": "시공사가 지적사항 시정 완료 사진을 보내면 현장에 가서 같은 각도에서 직접 확인한 뒤 종결한다."
  },
  {
   "id": "J10",
   "behavior": "접지저항 측정 당일 비가 내렸으면 측정을 미루고 다음 맑은 날 재측정 일정을 잡는다."
  },
  {
   "id": "J11",
   "behavior": "활선 근접 구간에서 잠금장치를 건 뒤 검전기로 무전압을 직접 확인하고서야 작업 시작을 허락한다."
  },
  {
   "id": "J12",
   "behavior": "접지 보조극을 박을 자리가 아스팔트면 시공사에게 화단이나 흙 구간을 찾아 옮기라고 한다."
  }
 ],
