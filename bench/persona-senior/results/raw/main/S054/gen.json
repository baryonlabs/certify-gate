 "knowledge": [
  {
   "id": "K1",
   "title": "변경작업 사전 백업 표준",
   "text": "네트워크 장비 설정 변경 전에는 running-config를 TFTP/SFTP 백업 서버에 저장하고 해시값을 기록한다. 변경 실패 시 직전 상태로 즉시 복구하기 위함이다."
  },
  {
   "id": "K2",
   "title": "변경 작업 시간대 기준",
   "text": "코어 스위치와 방화벽의 설정 변경은 승인된 유지보수 창(평일 01:00~05:00)에만 수행한다. 업무시간 중 변경은 서비스 영향 범위가 넓어 금지한다."
  },
  {
   "id": "K3",
   "title": "장애 등급별 초기 대응",
   "text": "장애 접수 시 영향 범위에 따라 1~3등급을 판정하고 1등급은 10분 내 상황실과 담당 임원에게 보고한다. 보고 지연으로 인한 의사결정 지연을 막기 위함이다."
  },
  {
   "id": "K4",
   "title": "광 모듈 점검 절차",
   "text": "광 트랜시버 교체 또는 점검 시 DOM(Digital Optical Monitoring) 값으로 Rx/Tx 광출력을 확인하고 기준 범위를 벗어나면 교체 대상으로 등록한다. 광 커넥터는 청소 후 결합한다."
  },
  {
   "id": "K5",
   "title": "패킷 캡처 수행 지침",
   "text": "패킷 캡처는 SPAN 포트 또는 TAP을 통해 수행하고 필터를 지정해 필요한 트래픽만 저장한다. 캡처 파일에는 개인정보가 포함될 수 있어 분석 후 지정 저장소에만 보관한다."
  },
  {
   "id": "K6",
   "title": "UPS·전원 이중화 점검",
   "text": "장비 랙의 이중 전원 모듈은 월 1회 각각 다른 PDU에 연결되어 있는지 확인한다. 한쪽 전원 계통 장애 시에도 장비가 중단되지 않도록 하기 위함이다."
  },
  {
   "id": "K7",
   "title": "방화벽 룰 변경 승인",
   "text": "방화벽 정책 추가·삭제는 변경 요청서와 보안팀 승인 후 반영하며, 변경 이력을 티켓에 기록한다. 임의 변경으로 인한 보안 사고와 감사 지적을 방지하기 위함이다."
  }
 ],
 "items": [
  {
   "id": "J01",
   "behavior": "코어 스위치 설정을 바꾸기 전에 TFTP 서버에 config를 올리고 해시 값을 메모장에 적어둔다."
  },
  {
   "id": "J02",
   "behavior": "전송 속도가 느리다는 문의에는 먼저 해당 구간 duplex 설정이 양쪽 일치하는지부터 본다."
  },
  {
   "id": "J03",
   "behavior": "방화벽 세션 테이블이 급증할 때 상위 출발지 IP 5개를 뽑아 같은 대역인지 눈으로 비교한다."
  },
  {
   "id": "J04",
   "behavior": "1등급 장애로 판정되면 원인 파악이 끝나기 전에 상황실 전화부터 건다."
  },
  {
   "id": "J05",
   "behavior": "광 트랜시버의 DOM 수신 값이 -14dBm 근처로 나오면 점검 대상 목록에 올린다."
  },
  {
   "id": "J06",
   "behavior": "월간 점검 때 랙 뒤편에서 서버와 스위치 전원 케이블이 서로 다른 PDU에 꽂혔는지 하나씩 따라간다."
  },
  {
   "id": "J07",
   "behavior": "패킷 캡처 결과에서 TCP 재전송이 보이면 재전송 간격이 일정한지 먼저 확인한다."
  },
  {
   "id": "J08",
   "behavior": "스위치 인터페이스 카운터를 보고 CRC 에러가 증가하는 포트의 케이블 색상 라벨을 먼저 확인한다."
  },
  {
   "id": "J09",
   "behavior": "장애 알람이 울리면 로그를 열기 전에 먼저 최근 24시간 내 변경 이력 목록부터 훑어본다."
  },
  {
   "id": "J10",
   "behavior": "새벽 작업 중 업링크 포트를 내리기 전에 맞은편 장비 로그인 세션을 하나 더 열어둔다."
  },
  {
   "id": "J11",
   "behavior": "방화벽 룰 삭제 요청이 오면 삭제 전에 해당 룰의 히트 카운트를 몇 달치 뽑아본다."
  },
  {
   "id": "J12",
   "behavior": "패킷 캡처 시 SPAN 포트에서 호스트와 포트 필터를 걸고 끝나면 지정 저장소로만 파일을 옮긴다."
  }
 ],
