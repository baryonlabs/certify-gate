 "knowledge": [
  {
   "id": "K1",
   "title": "배선 작업 전 도면 확인",
   "text": "배선 작업 착수 전 최신 개정 도면과 배선표의 일치 여부를 확인하고 개정 번호를 작업일지에 기록한다. 구도면으로 작업할 경우 재작업과 오결선이 발생하기 때문이다."
  },
  {
   "id": "K2",
   "title": "전선 굽힘 반경 기준",
   "text": "전선 포설 시 최소 굽힘 반경은 케이블 외경의 6배 이상으로 유지한다. 반경이 작으면 도체 손상과 절연 피복 균열이 생겨 장기 신뢰성이 저하되기 때문이다."
  },
  {
   "id": "K3",
   "title": "전선 식별 표찰 부착",
   "text": "전선 양단 100mm 이내에 회로 번호가 인쇄된 표찰을 부착하고 결선 후 육안으로 재확인한다. 유지보수 시 회로 추적을 쉽게 하고 오결선을 방지하기 위함이다."
  },
  {
   "id": "K4",
   "title": "압착 단자 체결 점검",
   "text": "압착 단자는 규격에 맞는 전용 공구로 압착한 뒤 당김 시험으로 이탈 여부를 확인한다. 압착 불량은 접촉 저항을 높여 운행 중 발열과 접속 불량을 일으킨다."
  },
  {
   "id": "K5",
   "title": "결선 후 절연저항 측정",
   "text": "배선 완료 후 회로별로 절연저항계를 사용해 절연저항을 측정하고 기준값 이상임을 점검표에 기록한다. 절연 불량 상태로 통전하면 단락과 기기 손상 위험이 있다."
  },
  {
   "id": "K6",
   "title": "작업 전 전원 차단 및 잠금",
   "text": "차량 내 작업 시작 전 해당 회로의 전원을 차단하고 잠금·태그를 부착한다. 작업 중 예기치 않은 통전으로 인한 감전 사고를 예방하기 위함이다."
  },
  {
   "id": "K7",
   "title": "케이블 덕트 고정 간격",
   "text": "덕트와 클램프를 이용한 전선 고정은 규정된 간격으로 실시하며 날카로운 모서리 통과부에는 보호 부재를 설치한다. 주행 진동에 의한 피복 마모를 막기 위함이다."
  }
 ],
 "items": [
  {
   "id": "J01",
   "behavior": "겨울철 아침에는 차량 안에서 PVC 전선을 한 시간 풀어 둔 뒤에 포설한다."
  },
  {
   "id": "J02",
   "behavior": "전선이 꺾이는 모서리 구간에서는 곡률을 손으로 잡아 둥글게 만들며 포설한다."
  },
  {
   "id": "J03",
   "behavior": "차량 안 패널을 열기 전 해당 회로 차단기에 개인 자물쇠와 태그를 건다."
  },
  {
   "id": "J04",
   "behavior": "단자 압착 후 당김 시험을 할 때 가는 선 단자는 손으로 천천히, 굵은 선은 짧게 세게 당긴다."
  },
  {
   "id": "J05",
   "behavior": "새 배선 작업을 시작하기 전 도면 하단의 개정 번호를 작업일지 기록과 대조한다."
  },
  {
   "id": "J06",
   "behavior": "차체 하부 간선을 당길 때 맞은편 작업자와 무전 대신 전선을 두 번 튕겨 신호를 맞춘다."
  },
  {
   "id": "J07",
   "behavior": "좁은 천장 덕트에 전선 다발을 넣기 전, 가는 끈을 먼저 끝까지 통과시켜 둔다."
  },
  {
   "id": "J08",
   "behavior": "전선 양 끝에서 손가락 한 마디 안쪽에 표찰을 붙이고 결선 후 다시 눈으로 훑는다."
  },
  {
   "id": "J09",
   "behavior": "절연저항 측정 전에 같은 회로의 단자대 나사를 드라이버로 한 번씩 더 조인다."
  },
  {
   "id": "J10",
   "behavior": "전선 다발을 묶은 결속 밴드 끝을 자르지 않고 한 번 더 당겨 조여 본다."
  },
  {
   "id": "J11",
   "behavior": "덕트 안 전선 고정 시 진동이 큰 대차 근처 구간은 클램프 간격을 더 좁게 잡는다."
  },
  {
   "id": "J12",
   "behavior": "여러 선이 모이는 분기 지점에서는 가장 긴 회로 선부터 먼저 깔고 짧은 선을 위에 얹는다."
  }
 ],
