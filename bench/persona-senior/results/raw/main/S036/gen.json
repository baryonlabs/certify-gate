 "knowledge": [
  {
   "id": "K1",
   "title": "방문 점검 기본 절차",
   "text": "세대 방문 시 신분증을 제시하고 점검 목적을 안내한 뒤 계량기, 중간밸브, 호스, 연소기 순으로 점검한다. 순서를 고정해야 누락 없이 기록과 대조할 수 있다."
  },
  {
   "id": "K2",
   "title": "가스누출 검지기 사용",
   "text": "배관 연결부와 밸브류는 휴대용 가스누출 검지기로 측정하며, 사용 전 영점을 확인하고 센서를 대상에서 1cm 이내로 접근시킨다. 거리가 멀면 저농도 누출이 검출되지 않기 때문이다."
  },
  {
   "id": "K3",
   "title": "비눗물 누출 확인법",
   "text": "검지기 반응이 있는 연결부는 비눗물을 도포하여 기포 발생 여부로 누출 위치를 확정한다. 검지기는 주변 가스를 함께 감지하므로 정확한 지점 확인에 별도 방법이 필요하다."
  },
  {
   "id": "K4",
   "title": "고무호스 교체 기준",
   "text": "고무호스는 균열, 경화, 변색이 확인되면 사용 연한과 관계없이 금속 플렉시블 호스로 교체를 권고한다. 노후 호스는 파열과 미세 누출의 원인이 된다."
  },
  {
   "id": "K5",
   "title": "누출 의심 시 조치",
   "text": "가스 냄새가 감지되면 중간밸브를 잠그고 창문을 열어 환기하며, 전기 스위치와 휴대전화 조작을 금지한다. 점화원에 의한 폭발을 방지하기 위함이다."
  },
  {
   "id": "K6",
   "title": "보일러 배기통 점검",
   "text": "보일러 배기통은 연결부 이탈, 부식, 기울기를 확인하고 실내로 배기가스가 역류하지 않는지 점검한다. 불완전 연소로 인한 일산화탄소 중독을 예방하기 위함이다."
  },
  {
   "id": "K7",
   "title": "점검 결과 기록 관리",
   "text": "점검 결과는 세대별 점검표에 당일 기록하고 부적합 사항은 소유자 서명을 받아 보관한다. 사후 분쟁과 재점검 시 이력 확인의 근거가 된다."
  }
 ],
