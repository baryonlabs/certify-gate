 "cost_usd": 0.0720154,
 "knowledge": [
  {
   "id": "K1",
   "title": "항온실 치수 측정 기준",
   "text": "정밀 치수 측정은 항온실(20±1℃)에서 시행하며, 가공 직후 부품은 2시간 이상 안정화한 뒤 CMM에 올린다. 열팽창에 의한 측정 오차를 방지하기 위함이다."
  },
  {
   "id": "K2",
   "title": "금형 교체 안전 조치",
   "text": "프레스 금형 교체 시 전원 차단 및 잠금(LOTO) 후 상형 하부에 낙하방지 블록을 삽입한다. 슬라이드 하강으로 인한 협착 사고를 방지하기 위함이다."
  },
  {
   "id": "K3",
   "title": "열처리 연삭 여유량",
   "text": "열처리 대상 코어·캐비티는 단면당 0.2~0.3mm 연삭 여유를 남기고 가공한다. 담금질 변형을 후가공에서 보정하기 위함이다."
  },
  {
   "id": "K4",
   "title": "방전면 백층 제거",
   "text": "와이어 방전 가공면은 사용 전 연마로 백층(재응고층)을 제거한다. 미세 균열과 조기 마모를 방지하기 위함이다."
  },
  {
   "id": "K5",
   "title": "시험 가공 기록 관리",
   "text": "트라이아웃 시 프레스 톤수·속도·윤활 조건을 시험 기록표에 기재하고 초기 샘플 5개를 채취한다. 양산 조건의 재현성을 확보하기 위함이다."
  },
  {
   "id": "K6",
   "title": "타발 금형 마모 점검",
   "text": "타발 금형은 50만 샷마다 펀치·다이 날끝 마모를 점검하고 연마 여부를 판정한다. 버 높이가 규격을 초과하는 것을 방지하기 위함이다."
  },
  {
   "id": "K7",
   "title": "조립 전 세척·방청",
   "text": "금형 조립 전 파팅면과 가이드 포스트의 이물을 세척하고 방청유를 얇게 도포한다. 이물 끼임에 의한 정밀도 저하와 부식을 방지하기 위함이다."
  }
 ],
 "items": [
  {
   "id": "J01",
   "behavior": "공차 ±0.01mm 홀 가공은 머시닝센터 오전 첫 작업 시간대로 일정을 잡아 달라고 요청한다."
  },
  {
   "id": "J02",
   "behavior": "금형 교환 때 상형 밑에 낙하방지 블록을 끼우고 전원함에 개인 자물쇠를 건다."
  },
  {
   "id": "J03",
   "behavior": "HRC58 경화강 엔드밀 가공 중 소리가 높아지면 이송 오버라이드를 80%로 낮춘다."
  },
  {
   "id": "J04",
   "behavior": "시험 가공 중 첫 5개 외에 스무 번째쯤 나온 부품도 따로 빼서 측정한다."
  },
  {
   "id": "J05",
   "behavior": "590MPa급 고장력강 타발 금형은 30만 샷 무렵에 펀치 날끝을 미리 꺼내 본다."
  },
  {
   "id": "J06",
   "behavior": "가이드 포스트를 끼운 상형을 손으로 천천히 내려 보며 스치는 소리가 나는지 귀를 기울인다."
  },
  {
   "id": "J07",
   "behavior": "조립 때 상·하형 고정 볼트를 대각선 순서로 세 번에 나눠 토크 렌치로 조인다."
  },
  {
   "id": "J08",
   "behavior": "소재 코일 로트가 바뀐 날은 시험 가공 전에 판재 두께를 마이크로미터로 먼저 잰다."
  },
  {
   "id": "J09",
   "behavior": "겨울 월요일 아침에는 설치한 프레스 금형을 저속으로 10분 공회전한 뒤 양산에 들어간다."
  },
  {
   "id": "J10",
   "behavior": "열처리 맡길 SKD11 코어 도면에 단면마다 0.25mm 연삭 여유를 적어 넣는다."
  },
  {
   "id": "J11",
   "behavior": "가공 끝난 다이 블록을 항온실 정반에 두 시간 올려둔 뒤 CMM 측정을 시작한다."
  },
  {
   "id": "J12",
   "behavior": "와이어 컷이 끝난 다이 개구부 내벽을 오일스톤으로 문질러 변색 막을 벗긴다."
  }
 ],
 "gold": {
