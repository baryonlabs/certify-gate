 "knowledge": [
  {
   "id": "K1",
   "title": "엔진오일 교환 절차",
   "text": "엔진오일 교환은 엔진을 충분히 예열한 뒤 정차시켜 오일을 배출하고, 드레인 플러그 와셔를 신품으로 교체하여 규정 토크로 체결한다. 오일이 완전히 배출되지 않거나 와셔가 재사용되면 누유가 발생하기 때문이다."
  },
  {
   "id": "K2",
   "title": "리프트 사용 안전 수칙",
   "text": "차량을 리프트에 올릴 때는 제조사 지정 지지점에 암을 정확히 위치시키고, 지면에서 약간 띄운 상태에서 흔들어 안정성을 확인한 후 상승시킨다. 지지점이 어긋나면 작업 중 차량이 낙하할 위험이 있다."
  },
  {
   "id": "K3",
   "title": "배터리 단자 분리 순서",
   "text": "전기 배선 작업 전에는 시동을 끄고 배터리 (-) 단자를 먼저 분리하며, 복구 시에는 (+) 단자를 먼저 연결한다. 공구가 차체에 접촉해 단락되는 것을 막기 위함이다."
  },
  {
   "id": "K4",
   "title": "경유차 연료필터 교환",
   "text": "경유차 연료필터는 제조사 권장 주기에 따라 교환하고, 교환 후에는 프라이밍 펌프로 연료 라인의 공기를 뺀 뒤 시동한다. 공기가 남으면 시동 불량과 인젝터 손상이 생길 수 있다."
  },
  {
   "id": "K5",
   "title": "브레이크 패드 점검 기준",
   "text": "브레이크 패드는 잔여 두께가 3mm 이하이면 교환하며, 교환 시 디스크 표면 상태와 캘리퍼 슬라이드 핀 작동도 함께 점검한다. 제동력 저하와 편마모를 예방하기 위한 기준이다."
  },
  {
   "id": "K6",
   "title": "폐유 및 폐부품 처리",
   "text": "사용 후 폐엔진오일과 폐필터는 지정된 폐유 저장 용기에 구분하여 보관하고 허가 업체에 인계한다. 토양과 수질 오염을 막고 관련 법규를 준수하기 위함이다."
  },
  {
   "id": "K7",
   "title": "공구 관리 및 정리",
   "text": "작업 종료 후 공구는 종류와 크기별로 지정 위치에 정리하고 분실 여부를 확인한다. 정비 중 공구가 엔진룸이나 하부에 남는 사고를 예방하기 위함이다."
  }
 ],
 "items": [
  {
   "id": "J01",
   "behavior": "교환한 폐오일 통과 폐필터를 작업대 옆 지정 드럼에 따로 넣는다."
  },
  {
   "id": "J02",
   "behavior": "냉간 시동한 경유 승합차의 엔진룸 위쪽에 귀를 대고 시동 직후 10초간 소리를 듣는다."
  },
  {
   "id": "J03",
   "behavior": "고객이 가져온 폐부품 중 알터네이터 벨트는 손으로 비틀어 갈라짐을 보고 같이 교환을 권한다."
  },
  {
   "id": "J04",
   "behavior": "하체 볼트를 풀 때 렌치 대신 임팩트를 쓰지 않고 긴 라쳇을 손으로 먼저 돌려 본다."
  },
  {
