 "knowledge": [
  {
   "id": "K1",
   "title": "작업 전 윗실·밑실 장력 점검",
   "text": "작업 시작 전 시험 원단에 시험 박음질을 하여 윗실과 밑실의 장력 균형을 확인한다. 장력이 맞지 않으면 퍼커링이나 실 끊김이 발생하기 때문이다."
  },
  {
   "id": "K2",
   "title": "바늘 교체 주기",
   "text": "바늘은 하루 작업 시작 전 끝 상태를 확인하고 휘거나 끝이 무디면 즉시 교체한다. 손상된 바늘은 올 풀림과 건너뜀 박음질의 원인이 된다."
  },
  {
   "id": "K3",
   "title": "원단별 바늘·실 규격 선정",
   "text": "원단 두께와 재질에 따라 작업지시서에 지정된 바늘 번수와 실 번수를 사용한다. 규격이 맞지 않으면 솔기 강도가 부족하거나 원단이 손상된다."
  },
  {
   "id": "K4",
   "title": "설비 급유 및 청소",
   "text": "교대 종료 시 노루발 주변과 북집의 먼지를 제거하고 지정 급유 지점에 재봉틀 전용 오일을 주입한다. 마찰 부위의 마모와 과열을 방지하기 위함이다."
  },
  {
   "id": "K5",
   "title": "작업 중 손 안전 수칙",
   "text": "바늘 아래에서 원단을 정리하거나 실을 제거할 때는 반드시 페달에서 발을 떼고 모터가 완전히 멈춘 뒤 작업한다. 바늘에 의한 손가락 부상을 방지하기 위함이다."
  },
  {
   "id": "K6",
   "title": "봉제 불량품 분류",
   "text": "박음질 후 건너뜀, 땀 불량, 올 나감 등이 발견된 제품은 불량 표시를 하고 분리 적치한다. 불량품이 정상품과 섞여 출하되는 것을 막기 위함이다."
  },
  {
   "id": "K7",
   "title": "이상 소음 발생 시 조치",
   "text": "작동 중 평소와 다른 소음이 발생하면 즉시 가동을 중지하고 정비 담당자에게 보고한다. 방치하면 부품 파손과 설비 정지로 이어지기 때문이다."
  }
 ],
 "items": [
  {
   "id": "J01",
   "behavior": "교대 끝에 북집을 열어 먼지를 털고, 얇은 원단 작업을 한 날은 평소보다 먼저 한 번 더 연다."
  },
  {
   "id": "J02",
   "behavior": "아침 첫 작업 전 자투리 원단에 한 줄 박아 윗실과 밑실 매듭 위치를 손끝으로 만져 본다."
  },
  {
   "id": "J03",
   "behavior": "바늘 아래 엉킨 실을 가위로 자를 때 페달에서 발을 완전히 떼고 휠이 멈추길 기다린다."
  },
  {
   "id": "J04",
   "behavior": "두꺼운 청바지 밑단을 박을 때 바늘을 한 단계 굵은 것으로 바꿔 끼운다."
  },
  {
   "id": "J05",
   "behavior": "점심 후 재봉틀 바늘 끝을 손톱에 대어 걸리는지 확인하고 바로 새 바늘로 바꾼다."
  },
  {
   "id": "J06",
   "behavior": "박음질 끝 되돌아박기 때 평소보다 한 땀 더 뒤로 가서 가볍게 겹쳐 박는다."
  },
  {
   "id": "J07",
   "behavior": "재봉틀 모터를 켜고 벨트 돌아가는 소리를 잠시 듣다가 노루발 높이 나사를 반 바퀴 돌린다."
  },
  {
   "id": "J08",
   "behavior": "박음질이 한 땀 건너뛴 점퍼를 따로 분리해 불량 표시를 하고 한쪽 상자에 쌓는다."
  },
  {
   "id": "J09",
   "behavior": "겨울 코트 안감을 박을 때 평소보다 박음질 속도를 줄이고 노루발을 손으로 살짝 받쳐 준다."
  },
  {
   "id": "J10",
   "behavior": "이웃이 맡긴 낡은 코트 소매 솔기를 뜯기 전에 안쪽 안감 쪽 올 상태를 불빛에 비춰 본다."
  },
  {
   "id": "J11",
   "behavior": "등산복 방수 원단 솔기를 박은 뒤 바늘 구멍 줄을 손톱으로 눌러 구멍 크기를 가늠한다."
  },
  {
   "id": "J12",
   "behavior": "장마철 눅눅한 날에는 밑실 보빈을 감아 둔 걸 쓰지 않고 새로 감아서 끼운다."
  }
 ],
