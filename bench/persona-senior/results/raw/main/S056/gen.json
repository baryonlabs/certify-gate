 "cost_usd": 0.0276454,
 "knowledge": [
  {
   "id": "K1",
   "title": "열처리로 승온 절차",
   "text": "열처리로는 장입 전 예열하고 소재 두께별 지정 승온 속도로 올리며, 급가열 시 내외부 온도차로 인한 변형·균열이 생기므로 설정 기울기를 준수한다."
  },
  {
   "id": "K2",
   "title": "담금질 냉각매체 관리",
   "text": "담금질유는 매 교대 시작 시 온도와 수분 혼입 여부를 점검하고 지정 범위 내에서 사용한다. 유온이 벗어나면 냉각 속도가 변해 경도 편차가 발생하기 때문이다."
  },
  {
   "id": "K3",
   "title": "경도 시험 실시 기준",
   "text": "열처리 완료 로트는 로크웰 경도 시험을 로트당 지정 수량 이상 실시하고 기록한다. 시험 전 표준 시험편으로 경도계를 교정하여 측정값 신뢰성을 확보한다."
  },
  {
   "id": "K4",
   "title": "템퍼링 즉시 실시",
   "text": "담금질 후 부품은 지정 시간 이내에 템퍼링로에 장입한다. 지연되면 잔류응력으로 지연 균열이 발생할 수 있기 때문이다."
  },
  {
   "id": "K5",
   "title": "열전대 교정 주기",
   "text": "로 내 열전대는 분기별로 교정하고 온도 균일도(TUS) 시험 결과를 기록한다. 지시 온도와 실제 온도의 편차를 관리하기 위함이다."
  },
  {
   "id": "K6",
   "title": "고온 작업 보호구 착용",
   "text": "로 장입·인출 작업 시 내열 장갑, 안면 보호구, 내열 앞치마를 착용한다. 고온 복사열과 담금질유 비산에 의한 화상을 예방하기 위함이다."
  },
  {
   "id": "K7",
   "title": "도면 부적합 보고 절차",
   "text": "도면과 실제 제품 치수가 상이할 때는 작업을 보류하고 부적합 보고서를 작성해 품질 부서에 통보한다. 승인 없는 임의 수정을 막고 이력을 추적하기 위함이다."
  }
 ],
 "items": [
  {
   "id": "J01",
   "behavior": "열전대 교정일이 안 됐어도 로 지시값과 보조 기록계 값이 벌어지면 가동을 멈추고 점검한다."
  },
  {
   "id": "J02",
   "behavior": "경도 시험 로트에서 측정값이 규격 하한에 가까우면 시험 개수를 늘려 다시 찍는다."
  },
  {
   "id": "J03",
   "behavior": "비 오는 장마철 아침에는 로 문을 열고 장입 대기 부품 표면을 손으로 만져 본다."
  },
  {
   "id": "J04",
   "behavior": "로 장입 때 내열 장갑과 안면 보호구를 착용한 채 집게를 잡는다."
  },
  {
   "id": "J05",
   "behavior": "장입 바구니에 얇은 와셔와 두꺼운 축류를 섞어 담지 않고 따로 나눠 돌린다."
  },
  {
   "id": "J06",
   "behavior": "로 도어를 닫을 때 나는 소리와 걸림 정도를 듣고 가스켓 부위를 손전등으로 비춘다."
  },
  {
   "id": "J07",
   "behavior": "도면과 실물 치수가 다르면 작업을 세우고 부적합 보고서를 작성한다."
  },
  {
   "id": "J08",
   "behavior": "도면 치수와 맞지 않는 부품을 받으면 현장 작업자에게 직접 가서 가공 이력을 묻는다."
  },
  {
   "id": "J09",
   "behavior": "담금질을 마친 축 부품을 식기 전에 곧바로 템퍼링로 앞 카트로 옮긴다."
  },
  {
   "id": "J10",
   "behavior": "담금질 탱크 유온계를 교대 시작 직후 확인하고 수분 혼입 여부를 눈으로 본다."
  },
  {
   "id": "J11",
   "behavior": "긴 샤프트를 유조에 넣을 때 끝을 수직으로 세워 천천히 담그는 각도와 속도를 손으로 조절한다."
  },
  {
   "id": "J12",
   "behavior": "처음 다루는 합금강 로트는 시험편 하나를 먼저 돌려 단면을 잘라 본 뒤 본 작업에 들어간다."
  }
 ],
