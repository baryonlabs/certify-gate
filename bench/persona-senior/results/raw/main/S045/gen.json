 "knowledge": [
  {
   "id": "K1",
   "title": "기준점 확인 및 장비 점검",
   "text": "측량 착수 전 토탈스테이션의 수준기와 광학구심을 점검하고 통합기준점·삼각점의 망실·훼손 여부를 확인한다. 기준점이 움직이거나 장비가 틀어진 채 측량하면 전체 성과가 어긋나기 때문이다."
  },
  {
   "id": "K2",
   "title": "경계복원측량 절차",
   "text": "경계복원측량은 지적도와 경계점좌표등록부를 대조해 좌표를 산출한 뒤 현지에 경계점 표지를 설치한다. 설치 후에는 인접 경계점 간 거리를 재측하여 등록 값과 허용 오차 이내인지 검증한다."
  },
  {
   "id": "K3",
   "title": "GNSS 관측 기준",
   "text": "GNSS 관측은 가용 위성 수와 PDOP 값을 확인한 후 시작하며, 수치가 기준을 벗어나면 관측을 중단하고 재개 시간을 조정한다. 위성 배치가 불량하면 좌표 오차가 커지기 때문이다."
  },
  {
   "id": "K4",
   "title": "측량 야장 기록 규정",
   "text": "관측값은 현장에서 즉시 야장에 기록하고 정정 시 원래 값이 보이도록 두 줄을 긋는다. 사후 검증과 분쟁 대응 시 원자료의 신뢰성을 입증해야 하기 때문이다."
  },
  {
   "id": "K5",
   "title": "도로변 측량 안전 수칙",
   "text": "도로 인접 구역에서 작업할 때는 안전조끼를 착용하고 안전콘과 신호수를 배치한다. 차량 접촉으로 인한 인명사고를 예방하기 위한 것이다."
  },
  {
   "id": "K6",
   "title": "토지 경계 인접자 입회",
   "text": "경계측량 시 인접 토지 소유자에게 사전 통지하고 입회를 요청하며, 표지 설치 후 결과를 설명한다. 경계 분쟁을 사전에 줄이기 위한 절차이다."
  },
  {
   "id": "K7",
   "title": "측량 성과 도면 검수",
   "text": "성과 도면은 작성자 외 1인이 좌표·면적·지번을 대조 검수한 뒤 제출한다. 입력 오류나 단순 실수가 그대로 공적 장부에 반영되는 것을 막기 위해서다."
  }
 ],
 "items": [
  {
   "id": "J01",
   "behavior": "경계 말뚝을 박기 전에 해머로 땅을 두세 번 쳐 소리를 듣고 위치를 20~30cm 옆으로 옮긴다."
  },
  {
   "id": "J02",
   "behavior": "겨울 이른 아침 현장에서 장비를 차 밖에 20분쯤 세워 두었다가 측량을 시작한다."
  },
  {
   "id": "J03",
   "behavior": "현장 측점을 하나 끝낼 때마다 수첩에 그 지점 주변 지물 위치를 손으로 스케치한다."
  },
  {
   "id": "J04",
   "behavior": "GNSS 수신기 화면에서 위성 수치를 보고 관측을 잠시 멈춘 채 차량 안에서 대기한다."
  },
  {
   "id": "J05",
   "behavior": "성과 도면을 제출하기 전에 후배에게 좌표·면적·지번을 소리 내어 대조하게 한다."
  },
  {
   "id": "J06",
   "behavior": "비 온 다음 날 아침에 삼각대 다리 밑 아스팔트 가장자리를 발로 눌러 보고 위치를 옮겨 세운다."
  },
  {
   "id": "J07",
   "behavior": "야장 숫자를 고칠 때 지우개 대신 원래 숫자 위에 두 줄을 긋고 옆에 새 값을 쓴다."
  },
  {
   "id": "J08",
   "behavior": "측량 시작 전에 토탈스테이션 수준기 기포를 돌려 가며 두 번 확인하고 광학구심 십자선을 점표에 맞춰 본다."
  },
  {
   "id": "J09",
   "behavior": "오후 늦게 측량하다가 해가 기울면 프리즘 방향을 바꿔 서쪽을 등지고 다시 관측한다."
  },
  {
   "id": "J10",
   "behavior": "입회 현장에서 인접 소유자가 오기 전에 먼저 도착해 경계 주변 담장·옹벽 기초 높이를 사진으로 남긴다."
  },
  {
   "id": "J11",
   "behavior": "교차로 옆 측점에서 작업할 때 안전콘을 차량 진행 방향 앞쪽까지 길게 늘어세운다."
  },
  {
   "id": "J12",
   "behavior": "경계점 표지 설치 후 인접 경계점 사이 거리를 줄자 대신 토탈스테이션으로 다시 재본다."
  }
 ],
