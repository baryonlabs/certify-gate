 "knowledge": [
  {
   "id": "K1",
   "title": "벽 타일 붙임 전 바탕면 점검",
   "text": "타일 시공 전 바탕면의 평탄도를 2m 직선자로 확인하고 허용 오차 3mm를 초과하는 부위는 미장으로 보정한다. 바탕이 고르지 않으면 접착제 두께가 달라져 타일 단차와 들뜸이 발생하기 때문이다."
  },
  {
   "id": "K2",
   "title": "타일 줄눈 시공 및 양생",
   "text": "타일 접착제가 충분히 경화된 뒤 줄눈재를 시공하며, 시공 후 24시간 동안 물 접촉과 보행을 금지한다. 경화 전 시공하면 줄눈이 갈라지고 수분이 타일 아래로 침투하기 때문이다."
  },
  {
   "id": "K3",
   "title": "도배 전 초배지 및 바탕 처리",
   "text": "도배 전 기존 벽지를 제거하고 석고보드 이음부와 균열부는 퍼티로 평탄하게 처리한 뒤 초배지를 바른다. 바탕 요철이 정배지에 비쳐 보이는 것을 막고 접착력을 확보하기 위함이다."
  },
  {
   "id": "K4",
   "title": "욕실 방수층 시공 기준",
   "text": "욕실 바닥과 벽 하단 30cm 이상까지 방수 도막을 2회 이상 도포하고, 시공 후 24시간 이상 담수 시험을 실시한다. 누수 여부를 타일 시공 전에 확인하여 하자 보수 비용을 줄이기 위함이다."
  },
  {
   "id": "K5",
   "title": "전동 절단기 사용 안전 수칙",
   "text": "타일 절단기와 그라인더 사용 시 보안경, 방진마스크, 보호장갑을 착용하고 절단 중 날 덮개를 제거하지 않는다. 비산 파편과 분진으로 인한 부상과 호흡기 질환을 예방하기 위함이다."
  },
  {
   "id": "K6",
   "title": "고소 작업 시 사다리 사용",
   "text": "천장 및 벽 상부 작업 시 A형 사다리는 벌림쇠를 완전히 잠그고 최상단 발판에 올라서지 않는다. 사다리 전도로 인한 추락 사고를 방지하기 위함이다."
  },
  {
   "id": "K7",
   "title": "실리콘 코킹 작업 기준",
   "text": "욕실 세면대와 욕조 주변 실리콘 시공 전 접합부의 물기와 이물질을 제거하고 마스킹테이프를 붙인 뒤 시공한다. 접착 불량과 곰팡이 발생을 줄이고 선을 균일하게 마감하기 위함이다."
  }
 ],
