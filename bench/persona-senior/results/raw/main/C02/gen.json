 "knowledge": [
  {
   "id": "K1",
   "title": "요구사항 명세서 작성 표준",
   "text": "요구사항은 기능·비기능 항목으로 구분하여 고유 번호를 부여하고, 각 항목에 검증 가능한 인수 조건을 함께 기재한다. 이는 개발자와 고객 간 해석 차이로 인한 재작업을 방지하기 위함이다."
  },
  {
   "id": "K2",
   "title": "설계 문서 검토 절차",
   "text": "설계서는 배포 전 개발자 2인 이상이 동료 검토를 수행하고 지적사항을 이슈 대장에 기록한다. 구현 착수 후 발견되는 설계 결함은 수정 비용이 크게 증가하기 때문이다."
  },
  {
   "id": "K3",
   "title": "일정 변경 승인 규정",
   "text": "마일스톤 일정이 3일 이상 변동될 경우 변경 사유와 영향 범위를 작성하여 PMO와 고객 담당자에게 사전 보고한다. 이를 통해 후속 일정과 자원 배정의 충돌을 방지한다."
  },
  {
   "id": "K4",
   "title": "코드 리뷰 및 병합 기준",
   "text": "모든 풀 리퀘스트는 최소 1인 이상의 승인과 자동 테스트 통과 후에만 메인 브랜치에 병합한다. 검증되지 않은 코드가 운영 환경에 유입되는 것을 막기 위한 절차이다."
  },
  {
   "id": "K5",
   "title": "릴리스 전 점검표 운영",
   "text": "릴리스 전날 회귀 테스트 결과, 롤백 계획, 데이터 마이그레이션 검증 여부를 점검표에 따라 확인하고 서명한다. 배포 후 장애 발생 시 신속히 복구할 수 있도록 하기 위함이다."
  },
  {
   "id": "K6",
   "title": "장애 대응 및 사후 분석",
   "text": "운영 장애 발생 시 심각도를 1~3등급으로 분류하여 보고하고, 해소 후 5영업일 이내에 원인 분석 보고서를 작성한다. 동일 장애의 재발을 방지하기 위한 조치이다."
  },
  {
   "id": "K7",
   "title": "형상 및 브랜치 관리 지침",
   "text": "기능 개발은 개별 브랜치에서 진행하고 릴리스 브랜치에는 태그를 부여하여 버전을 관리한다. 특정 시점의 소스를 정확히 재현하고 변경 이력을 추적하기 위함이다."
  }
 ],
