 "knowledge": [
  {
   "id": "K1",
   "title": "인장시험편 치수 측정",
   "text": "시험 전 시험편의 평행부 직경과 두께를 마이크로미터로 3개소 이상 측정하고 평균 단면적을 산출한다. 단면적 오차는 강도 계산에 직접 반영되므로 측정값은 시험 기록지에 즉시 기재한다."
  },
  {
   "id": "K2",
   "title": "만능시험기 교정 주기",
   "text": "만능시험기의 로드셀은 연 1회 공인 교정을 받고, 교정 유효기간이 지난 장비로는 성적서용 시험을 수행하지 않는다. 교정 기록은 장비 이력 카드에 보관하여 추적성을 확보한다."
  },
  {
   "id": "K3",
   "title": "인장 시험 속도 설정",
   "text": "인장시험은 KS B 0802에 따라 항복 전 구간과 항복 이후 구간의 변형 속도를 구분해 설정한다. 속도가 규정 범위를 벗어나면 항복점과 인장강도 값이 달라지므로 시험 전 설정값을 확인한다."
  },
  {
   "id": "K4",
   "title": "로크웰 경도 시험 압흔 간격",
   "text": "로크웰 경도 시험에서 인접한 압흔 사이의 거리는 압흔 지름의 3배 이상, 시험편 가장자리와의 거리도 규정 이상으로 둔다. 압흔 주변의 가공경화 영향이 다음 측정값에 섞이는 것을 막기 위함이다."
  },
  {
   "id": "K5",
   "title": "파단 시험편 보관 및 폐기",
   "text": "시험이 끝난 파단 시험편은 시료 번호를 표기해 성적서 발행 후 3개월간 보관하고, 이후 폐기 대장을 작성해 처리한다. 이의 제기가 있을 때 재확인이 가능하도록 하기 위함이다."
  },
  {
   "id": "K6",
   "title": "시험 성적서 검토 절차",
   "text": "성적서는 작성자가 입력한 수치를 원시 데이터와 대조하고, 기술 책임자의 승인 서명을 받은 후에 발행한다. 전사 오류와 단위 착오가 고객에게 전달되는 것을 방지하기 위함이다."
  },
  {
   "id": "K7",
   "title": "시험기 그립 및 보호 장비",
   "text": "고강도 시험편을 인장할 때는 보호 덮개를 닫고 보안경을 착용한 상태에서 시험을 시작한다. 파단 시 시험편 파편이 비산할 수 있기 때문이다."
  }
 ],
 "items": [
  {
   "id": "J01",
   "behavior": "여름 장마철에는 아침 첫 시험 전에 시험기를 20분가량 공회전시키고 하중 영점을 다시 잡는다."
  },
  {
   "id": "J02",
   "behavior": "의뢰 시편이 한꺼번에 들어오면 두꺼운 단면부터 시험하고 얇은 판재는 오후로 미룬다."
  },
  {
   "id": "J03",
   "behavior": "시험 시작 전 시험기 장비 이력 카드의 교정 만료일을 확인한 뒤 시험편을 장착한다."
  },
  {
