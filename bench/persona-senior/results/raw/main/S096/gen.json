  {
   "id": "K1",
   "title": "스프링클러 배관 수압시험",
   "text": "스프링클러 배관 설치 완료 후 방호구역별로 1.4MPa 이상의 수압을 2시간 유지하여 누수와 압력 강하 여부를 확인한다. 접합부 결함을 마감 전에 발견해 천장·벽체 해체 재시공을 방지하기 위함이다."
  },
  {
   "id": "K2",
   "title": "감지기 설치 높이·간격 기준",
   "text": "연기감지기와 열감지기는 설계도서와 NFTC 기준에 따라 천장 높이별 설치 면적과 벽·환기구 이격거리를 지켜 설치한다. 기류와 보 형상에 의한 감지 지연을 막기 위함이다."
  },
  {
   "id": "K3",
   "title": "소방 도면 현장 대조 절차",
   "text": "시공 착수 전 소방 도면과 건축·기계·전기 도면을 겹쳐 확인하고 간섭 사항은 설계 변경 요청서로 기록하여 감리자 승인을 받은 후 시공한다. 임의 변경에 따른 준공검사 부적합을 방지하기 위함이다."
  },
  {
   "id": "K4",
   "title": "배관 지지 간격과 행거 설치",
   "text": "배관은 관경별 기준 간격 이내로 행거를 설치하고 헤드 인접 지점과 분기 배관에는 별도 지지를 둔다. 수격이나 헤드 작동 시 반동으로 인한 배관 이탈을 막기 위함이다."
  },
  {
   "id": "K5",
   "title": "방화구획 관통부 내화 충진",
   "text": "방화구획 벽·슬래브를 관통한 배관과 케이블 주변은 인정받은 내화충진재로 시공하고 시공 사진과 시공일을 기록한다. 화염과 연기의 구획 간 확산을 차단하기 위함이다."
  },
  {
   "id": "K6",
   "title": "화기작업 허가 및 감시",
   "text": "용접·절단 등 화기작업은 작업허가서를 발급받고 소화기를 비치하며 작업 종료 후 30분간 잔불을 감시한다. 불티로 인한 가연물 발화를 방지하기 위함이다."
  },
  {
   "id": "K7",
   "title": "수신기 연동시험 점검표",
   "text": "공사 완료 후 수신기에서 구역별 감지기·발신기 동작 신호와 경보 연동을 점검표에 따라 시험하고 결과를 서명 기록한다. 회로 오결선과 오동작을 준공 전에 찾아내기 위함이다."
  }
 ],
