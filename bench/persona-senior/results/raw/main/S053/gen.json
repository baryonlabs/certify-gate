 "knowledge": [
  {
   "id": "K1",
   "title": "레이어 구분 작성 기준",
   "text": "구조물, 지장물, 계획선은 사내 표준 레이어에 구분하여 작성한다. 색상과 선종이 섞이면 출력 시 선 굵기가 달라져 시공자가 오독할 수 있기 때문이다."
  },
  {
   "id": "K2",
   "title": "측량 성과 좌표 대조",
   "text": "측량 성과 파일을 받으면 작업 전에 좌표계와 기준점 명칭을 성과표와 대조한다. 좌표가 어긋난 채 작업하면 구조물 위치가 전체적으로 이동하기 때문이다."
  },
  {
   "id": "K3",
   "title": "설계변경 개정 표기",
   "text": "설계변경 시 변경 부분에 구름 표시를 하고 표제란 개정란에 개정 기호와 일자를 기록한다. 현장에서 무엇이 바뀌었는지 즉시 식별할 수 있게 하기 위해서다."
  },
  {
   "id": "K4",
   "title": "구판 도면 회수 절차",
   "text": "개정 도면을 배포할 때 이전 출력본은 회수하거나 폐기 표시를 한다. 구판 도면으로 시공되는 사고를 막기 위해서다."
  },
  {
   "id": "K5",
   "title": "작업 파일 백업 규정",
   "text": "작업을 마칠 때마다 서버 지정 폴더에 날짜를 붙여 저장한다. 파일이 손상되어도 전날 상태로 복구할 수 있어야 하기 때문이다."
  },
  {
   "id": "K6",
   "title": "출력 전 검도 점검표",
   "text": "출력 전에 점검표로 축척, 치수 단위, 도곽 크기를 확인하고 출력물의 축척 막대를 자로 실측한다. 인쇄 설정 오류로 치수를 잘못 읽는 일을 막기 위해서다."
  },
  {
   "id": "K7",
   "title": "횡단 수정 시 물량 확인",
   "text": "횡단면을 수정하면 토공량 산출서의 해당 측점 수치를 다시 확인한다. 도면과 물량이 달라지면 공사비 정산에서 분쟁이 생기기 때문이다."
  }
 ],
