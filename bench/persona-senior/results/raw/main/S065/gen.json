 "knowledge": [
  {
   "id": "K1",
   "title": "초음파탐상 장비 교정",
   "text": "초음파탐상 시작 전과 4시간마다, 그리고 탐촉자나 케이블을 교체할 때마다 표준시험편(V1, V2)으로 거리 및 감도 교정을 수행한다. 장비 상태 변화로 인한 지시 위치와 크기 오판을 막기 위함이다."
  },
  {
   "id": "K2",
   "title": "접촉매질 도포 기준",
   "text": "초음파탐상 시 표면 온도가 50℃를 넘으면 일반 접촉매질 대신 고온용 매질을 사용하고, 탐촉자를 한 지점에 오래 두지 않는다. 고온에서 매질이 증발하거나 탐촉자가 손상되어 신호가 불안정해지는 것을 방지하기 위함이다."
  },
  {
   "id": "K3",
   "title": "방사선 투과검사 구역 통제",
   "text": "방사선 촬영 전 관리구역 경계에 로프와 경고등을 설치하고 구역 내 인원이 없음을 확인한 뒤 선원을 노출한다. 촬영 중에는 개인 선량계를 착용하고 선량률을 측정하여 작업자의 피폭을 최소화한다."
  },
  {
   "id": "K4",
   "title": "필름 판독 환경",
   "text": "방사선 투과 필름은 암실 조건에서 필름 판독기로 농도 2.0~4.0 범위를 확인하며 판독한다. 주변 광이 있으면 미세한 지시를 놓칠 수 있기 때문이다."
  },
  {
   "id": "K5",
   "title": "검사 표면 전처리",
   "text": "용접부 초음파탐상 전에는 스패터와 녹, 도장을 와이어브러시나 그라인더로 제거하여 탐촉자 이동 구간의 표면을 매끄럽게 한다. 표면 거칠기에 의한 접촉 불량과 신호 감쇠를 막기 위함이다."
  },
  {
   "id": "K6",
   "title": "검사 기록서 작성",
   "text": "검사 결과는 검사 당일 기록서에 장비 번호, 탐촉자 규격, 지시 위치와 크기, 판정 결과를 기재하고 검사원이 서명한다. 사후 재검증과 이력 추적이 가능하도록 하기 위함이다."
  },
  {
   "id": "K7",
   "title": "고소 및 밀폐 공간 작업",
   "text": "탱크, 배관 내부 등 밀폐 공간에서 검사할 때는 산소 및 유해가스 농도를 측정하고 2인 1조로 작업한다. 질식과 추락 사고를 예방하기 위함이다."
  }
 ],
 "items": [
  {
   "id": "J01",
   "behavior": "그라인더로 용접 비드 옆을 갈다가 탐촉자를 올려 보고 미끄러운 느낌이면 한 번 더 간다."
  },
  {
   "id": "J02",
   "behavior": "비 온 다음 날 야외 배관 용접부는 표면이 말라 보여도 탐촉자를 대기 전에 헝겊으로 한 번 더 닦는다."
  },
  {
   "id": "J03",
   "behavior": "필름 판독 때 방 조명을 끄고 판독기 불빛만 켠 채 한참 눈을 적응시킨다."
  },
  {
   "id": "J04",
   "behavior": "후배가 찍은 필름 중 가장자리에 미세한 흐림이 있는 것은 판독 전에 재촬영 대상으로 따로 빼 놓는다."
  },
  {
   "id": "J05",
