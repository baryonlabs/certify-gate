 "knowledge": [
  {
   "id": "K1",
   "title": "패널 양중 전 줄걸이 점검",
   "text": "양중 전에 와이어로프·슬링벨트의 꼬임, 소선 끊김, 마모 상태와 인양 고리 체결 상태를 점검표에 따라 확인한다. 손상된 줄걸이 용구는 인양 중 파단으로 낙하 사고를 일으킬 수 있으므로 즉시 교체한다."
  },
  {
   "id": "K2",
   "title": "풍속에 따른 양중 중지",
   "text": "순간풍속이 초속 10m를 초과하면 패널 양중 작업을 중지하고, 초속 15m 이상이면 크레인 작업을 전면 중단한다. 패널은 면적이 넓어 바람을 받으면 흔들림이 커져 위치 제어가 어렵기 때문이다."
  },
  {
   "id": "K3",
   "title": "패널 수평 레벨 확인",
   "text": "패널 거치 후 레이저 레벨 또는 수평계로 상단 레벨을 측정하여 허용 오차 ±5mm 이내인지 확인한다. 수평 오차가 누적되면 상부 패널의 접합부가 어긋나므로 층마다 확인한다."
  },
  {
   "id": "K4",
   "title": "임시 지지대 설치 및 해체",
   "text": "패널을 거치한 직후 가새형 임시 지지대(스트럿)를 바닥 앵커에 체결하고, 본접합이 끝나기 전에는 줄걸이를 해제하지 않는다. 고정 전 해제하면 패널이 전도될 위험이 있다."
  },
  {
   "id": "K5",
   "title": "신호수 수신호 통일",
   "text": "양중 작업 시 지정된 신호수 1인만 표준 수신호로 운전원에게 지시하며, 신호수와 운전원은 작업 전 신호 체계를 서로 확인한다. 복수의 지시가 섞이면 오작동으로 인한 협착 사고가 발생할 수 있다."
  },
  {
   "id": "K6",
   "title": "적재 패널 받침목 설치",
   "text": "현장 야적 시 패널은 지정된 받침목 위에 수직 거치대 또는 A형 프레임으로 세워 적재하고 단수를 제한한다. 받침목 간격이 어긋나면 하중이 집중되어 패널에 균열이 생기거나 넘어질 수 있다."
  },
  {
   "id": "K7",
   "title": "접합부 철근·볼트 체결",
   "text": "패널 간 접합부는 설계도에 명시된 규격의 볼트와 접합 철물로 체결하고 토크렌치로 규정 토크를 확인한다. 규정 토크에 미달하면 접합부 강성이 저하되므로 체결 후 표시 마킹을 한다."
  }
 ],
 "items": [
  {
   "id": "J01",
   "behavior": "아침 패널 야적장에서 받침목 위 패널 모서리에 손톱을 대고 긁어 본다."
  },
  {
   "id": "J02",
   "behavior": "와이어로프를 손바닥으로 훑어 내려가며 소선이 튀어나온 곳이 없는지 만져 본다."
  },
  {
   "id": "J03",
   "behavior": "겨울 이른 아침에는 앵커 볼트 구멍 속에 막대를 넣어 이물을 긁어낸 뒤 체결한다."
  },
  {
   "id": "J04",
   "behavior": "받침목 위에 패널을 세운 뒤 맨 아래 패널의 받침목 한쪽 끝을 발로 눌러 본다."
  },
  {
   "id": "J05",
   "behavior": "손끝이 떨리는 날에는 패널을 유도하는 자리에서 한 발 물러나 젊은 동료에게 유도봉을 넘긴다."
  },
  {
   "id": "J06",
   "behavior": "본접합 전에는 줄걸이를 풀지 않고 스트럿이 앵커에 체결됐는지 발로 밀어 본다."
  },
  {
   "id": "J07",
   "behavior": "패널 접합면 사이 틈에 담배 종이 두께의 얇은 쐐기를 끼워 보고 걸리는 위치를 확인한다."
  },
  {
   "id": "J08",
   "behavior": "토크렌치로 볼트를 조인 뒤 볼트 머리에서 철물 쪽으로 펜으로 선을 긋는다."
  },
  {
   "id": "J09",
   "behavior": "패널이 와이어에 매달려 올라갈 때 줄걸이 고리 쪽이 아닌 패널 하단 모서리의 흔들림을 쳐다본다."
  },
  {
   "id": "J10",
   "behavior": "패널을 내려놓은 뒤 눈높이를 맞춰 상단 모서리를 가늠해 보고 레이저 레벨을 가져온다."
  },
  {
   "id": "J11",
   "behavior": "깃발이 팽팽하게 펴지고 비닐이 날리는 오후에는 크레인 운전원에게 작업 보류를 요청한다."
  },
  {
   "id": "J12",
   "behavior": "신호수가 손짓하기 전에 먼저 패널 아래쪽 사람이 없는지 둘러보고 헛기침으로 주의를 준다."
  }
 ],
