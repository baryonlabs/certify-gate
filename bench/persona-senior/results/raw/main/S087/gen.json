 "knowledge": [
  {
   "id": "K1",
   "title": "염료 투입 전 욕비 확인",
   "text": "염료 투입 전 작업지시서의 욕비와 원단 중량을 대조하여 급수량을 설정한다. 욕비가 어긋나면 염착량이 달라져 동일 로트 내 색차가 발생하기 때문이다."
  },
  {
   "id": "K2",
   "title": "승온 속도 관리 기준",
   "text": "승온 구간에서는 지시서에 명시된 분당 승온 속도를 초과하지 않도록 증기 밸브를 조절한다. 급격한 승온은 염료의 불균일 흡착과 얼룩을 일으키기 때문이다."
  },
  {
   "id": "K3",
   "title": "고온 배출 전 냉각 확인",
   "text": "염색 완료 후 배출 전에는 욕조 온도가 80도 이하로 내려갔는지 온도계로 확인한다. 고온 상태에서 배출하면 증기 분출로 인한 화상과 원단 주름이 생길 수 있다."
  },
  {
   "id": "K4",
   "title": "압력 밸브 일일 점검",
   "text": "매 근무 시작 시 안전밸브와 압력계의 지시값을 점검표에 기록하고 이상 시 정비팀에 보고한다. 밸브 고착은 과압 사고로 이어질 수 있어 정기 확인이 필요하다."
  },
  {
   "id": "K5",
   "title": "샘플 대조 색상 검사",
   "text": "염색 종료 후 표준 샘플과 표준광원 아래에서 색상을 대조하여 합격 여부를 판정한다. 광원에 따라 색이 다르게 보이므로 지정된 광원 조건에서만 판정한다."
  },
  {
   "id": "K6",
   "title": "약품 취급 보호구 착용",
   "text": "가성소다, 분산제 등 약품을 계량하거나 투입할 때는 보호안경, 내화학 장갑, 앞치마를 착용한다. 피부 접촉 시 화상과 염증 위험이 있어 착용을 의무화한다."
  },
  {
   "id": "K7",
   "title": "염색기 세척 주기",
   "text": "색상이 바뀌는 로트 전환 시 염색기 내부를 세척하고 잔류 염료 여부를 확인한다. 잔류 염료는 다음 로트의 오염과 색상 불량의 원인이 된다."
  }
 ],
