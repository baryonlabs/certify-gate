 "knowledge": [
  {
   "id": "K1",
   "title": "설비 정비 전 잠금·표지(LOTO)",
   "text": "정비 착수 전 주전원을 차단하고 잠금장치와 표지를 부착하며, 잔압·잔류에너지를 방출한 뒤 작업한다. 예기치 않은 기동으로 인한 협착·감전 사고를 방지하기 위함이다."
  },
  {
   "id": "K2",
   "title": "볼트 체결 토크 관리",
   "text": "주요 체결부는 규정 토크값에 맞춰 토크렌치로 체결하고 대각선 순서로 2~3회 나누어 조인다. 체결력이 편중되면 풀림이나 변형이 생기기 때문이다."
  },
  {
   "id": "K3",
   "title": "기어박스 윤활유 교환",
   "text": "기어박스 오일은 가동 시간 기준 주기에 따라 교환하며, 교환 전 설비를 정지시켜 오일이 따뜻할 때 배출한다. 배출유 내 금속 이물을 확인해 마모 상태를 점검한다."
  },
  {
   "id": "K4",
   "title": "V벨트 장력 점검",
   "text": "V벨트는 월 1회 중앙부 처짐량을 측정하여 기준 범위 내인지 확인하고, 마모·균열이 있으면 풀리 단위로 일괄 교체한다. 장력 부족은 슬립을, 과다는 베어링 손상을 유발한다."
  },
  {
   "id": "K5",
   "title": "유압 호스 점검 및 교체",
   "text": "유압 호스는 주 1회 외피 균열·부풀음·누유 여부를 육안 점검하고 이상 시 즉시 교체한다. 고압 파열 시 작업자 부상과 설비 정지가 발생할 수 있기 때문이다."
  },
  {
   "id": "K6",
   "title": "베어링 그리스 주입",
   "text": "베어링에는 지정 그리스를 정해진 주기에 규정량만 주입한다. 과다 주입은 발열과 씰 손상의 원인이 되므로 금지한다."
  },
  {
   "id": "K7",
   "title": "정비 후 시운전 확인",
   "text": "정비 완료 후 공구와 이물을 회수하고 방호덮개를 복원한 뒤 무부하 시운전을 실시한다. 소음·진동·온도를 확인하고 이상이 없을 때 생산 부서에 인계한다."
  }
 ],
