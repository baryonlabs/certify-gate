 "knowledge": [
  {
   "id": "K1",
   "title": "레거시 시스템 현황 조사",
   "text": "마이그레이션 착수 전 대상 시스템의 인터페이스, 배치 작업, 테이블 목록을 전수 조사하여 현황 문서로 작성한다. 누락된 연동이 전환 후 장애로 이어지는 것을 막기 위함이다."
  },
  {
   "id": "K2",
   "title": "데이터 매핑 정의서 작성",
   "text": "원천 테이블과 목표 테이블의 컬럼별 매핑, 코드값 변환 규칙, 널 처리 기준을 정의서에 기록하고 개발자와 검수를 거친다. 변환 기준이 구두로만 전달되면 데이터 불일치가 발생하기 때문이다."
  },
  {
   "id": "K3",
   "title": "요구사항 인터뷰 기록",
   "text": "현업 사용자 인터뷰는 업무 단위로 진행하고 결과를 요구사항 정의서에 번호를 부여해 기록한다. 추적성을 확보해 설계 변경 시 영향 범위를 확인하기 위함이다."
  },
  {
   "id": "K4",
   "title": "이행 리허설 수행",
   "text": "본 전환 전 운영 데이터 사본으로 최소 2회 이행 리허설을 실시하고 소요 시간과 건수 대조 결과를 기록한다. 전환 시간 창 내 완료 가능 여부를 사전에 검증하기 위함이다."
  },
  {
   "id": "K5",
   "title": "롤백 계획 수립",
   "text": "본 전환 시 단계별 롤백 절차와 판단 기준 시점을 문서화하고 승인권자의 사전 서명을 받는다. 장애 발생 시 신속히 구 시스템으로 복귀하기 위함이다."
  },
  {
   "id": "K6",
   "title": "설계 산출물 형상관리",
   "text": "설계서와 ERD는 버전 번호를 부여해 형상관리 저장소에 등록하고 변경 시 변경 이력을 남긴다. 팀원이 서로 다른 버전을 참조하는 것을 방지하기 위함이다."
  },
  {
   "id": "K7",
   "title": "사용자 인수 테스트 진행",
   "text": "전환 완료 후 현업 담당자가 시나리오별 체크리스트로 인수 테스트를 수행하고 서명한다. 실제 업무 흐름에서의 이상 여부를 현업이 직접 확인하게 하기 위함이다."
  }
 ],
