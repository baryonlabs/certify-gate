 "knowledge": [
  {
   "id": "K1",
   "title": "압축강도 시험체 제작",
   "text": "모르타르 시험체는 KS L ISO 679에 따라 시멘트·표준사·물을 정해진 배합비로 혼합하고, 몰드에 2층으로 다져 채운다. 배합과 다짐 조건을 일정하게 유지해야 시험 간 재현성이 확보된다."
  },
  {
   "id": "K2",
   "title": "양생 수조 온도 관리",
   "text": "시험체는 20±1℃ 수조에서 양생하며 하루 두 차례 수온을 기록한다. 양생 온도가 벗어나면 강도 발현이 달라져 결과를 신뢰할 수 없기 때문이다."
  },
  {
   "id": "K3",
   "title": "압축강도 시험기 교정",
   "text": "압축강도 시험기는 연 1회 공인 교정을 받고 월 1회 표준 시험체로 점검한다. 허용 편차를 넘으면 사용을 중지하고 교정 후 재사용한다."
  },
  {
   "id": "K4",
   "title": "재령별 시험 시각 준수",
   "text": "압축강도는 재령 3일, 7일, 28일에 규정 허용 시간 이내에 시험한다. 재령 시각이 어긋나면 강도값이 달라지므로 시험 시각을 일지에 기록한다."
  },
  {
   "id": "K5",
   "title": "시료 채취와 보관",
   "text": "출하 시멘트 시료는 정해진 위치에서 채취해 밀폐 용기에 담고 라벨에 일시와 로트를 기재한다. 습기를 흡수하면 응결과 강도 특성이 변하므로 밀폐 보관한다."
  },
  {
   "id": "K6",
   "title": "화학 성분 분석 전처리",
   "text": "화학 성분 분석용 시료는 105℃ 건조 후 데시케이터에서 식혀 칭량한다. 수분이 남으면 조성 비율에 오차가 생기기 때문이다."
  },
  {
   "id": "K7",
   "title": "시험실 분진 보호구 착용",
   "text": "시멘트 분말을 다루는 작업에서는 방진 마스크, 보안경, 내알칼리 장갑을 착용한다. 분진과 알칼리 성분이 호흡기와 피부, 눈에 손상을 주기 때문이다."
  }
 ],
