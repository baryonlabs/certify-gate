 "knowledge": [
  {
   "id": "K1",
   "title": "개선면 청소와 개선각 확인",
   "text": "용접 전 개선면과 인접 20mm 범위의 유분·녹·페인트를 연삭으로 제거하고 개선각을 게이지로 확인한다. 오염물이 남으면 용착금속에 기공이 생기기 때문이다."
  },
  {
   "id": "K2",
   "title": "저수소봉 건조·보관",
   "text": "저수소계 용접봉은 300~350℃에서 1시간 건조한 뒤 100~150℃ 보온 오븐에 보관하고, 휴대용 보온통으로 반출하며 대기 노출 4시간을 넘기면 재건조한다. 피복이 흡습하면 용착금속에 수소 균열이 생기기 때문이다."
  },
  {
   "id": "K3",
   "title": "예열·층간온도 관리",
   "text": "Cr-Mo 배관은 시방서에 정한 예열온도 이상으로 가열하고 층간온도 상한을 넘기지 않도록 온도 초크로 확인한다. 이는 열영향부의 경화와 균열을 막기 위한 것이다."
  },
  {
   "id": "K4",
   "title": "TIG 루트 백퍼징",
   "text": "TIG 루트패스 전에 배관 내부를 아르곤으로 퍼지하고 산소 농도가 0.1% 이하인지 분석기로 확인한 뒤 용접한다. 이면 비드가 산화되어 내식성이 떨어지는 것을 막기 위해서이다."
  },
  {
   "id": "K5",
   "title": "화기작업 허가·가스측정",
   "text": "화기작업 전 허가서를 받고 작업구역의 가연성 가스 농도를 측정해 기준 이하임을 확인한다. 배관과 설비에 남은 잔류 가스가 아크 불꽃에 폭발할 수 있기 때문이다."
  },
  {
   "id": "K6",
   "title": "패스별 슬래그 제거·외관검사",
   "text": "각 패스를 마친 뒤 슬래그를 완전히 제거하고 언더컷과 기공 여부를 육안으로 점검한 후 다음 패스를 쌓는다. 결함 위에 덧쌓으면 내부 결함이 묻히기 때문이다."
  },
  {
   "id": "K7",
   "title": "용접 케이블·차단기 점검",
   "text": "작업 시작 전 용접기 1·2차 케이블의 피복과 접속부 손상, 누전차단기 작동 여부를 점검표로 확인한다. 배관 내부처럼 도체와 접촉하는 환경에서는 절연 불량이 감전 사고로 이어지기 때문이다."
  }
 ],
 "items": [
  {
   "id": "J01",
   "behavior": "맨홀이 열린 반대쪽 배관 개구부에 비닐을 덧대고 나서 용접한다."
  },
  {
   "id": "J02",
   "behavior": "온도 초크를 배관에 그어 놓고 토치로 이음부 둘레를 돌려 가열한다."
  },
  {
   "id": "J03",
   "behavior": "허가서에 서명이 있어도 측정기 화면의 수치를 직접 확인한 뒤 아크를 켠다."
  },
  {
   "id": "J04",
